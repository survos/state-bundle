{% extends ['base.html.twig', '@SurvosState/layout.html.twig'] %}
{% block page_title "%s Workflow"|format(flowCode) %}
{% block page_subtitle "Explore the states and the paths between them" %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        .wf-explorer { --wf-blue: #2563eb; --wf-ink: #243247; --wf-muted: #64748b; color: var(--wf-ink); }
        .wf-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 18px; }
        .wf-canvas, .wf-sidebar { border: 1px solid #dce3ec; border-radius: 16px; background: #fff; overflow: hidden; box-shadow: 0 3px 12px #24324706; }
        .wf-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 16px 20px; border-bottom: 1px solid #e8edf3; }
        .wf-eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 10px; font-weight: 700; color: var(--wf-muted); }
        .wf-toolbar h2 { margin: 3px 0 0; font-size: 16px; font-weight: 650; }
        .wf-controls { display: flex; gap: 6px; }
        .wf-button { border: 1px solid #dce3ec; border-radius: 8px; background: #fff; color: var(--wf-ink); padding: 7px 11px; font: inherit; font-size: 12px; cursor: pointer; }
        .wf-button:hover { background: #eff6ff; border-color: #93b4f5; }
        .wf-button:focus-visible, .wf-place:focus-visible { outline: 3px solid #93b4f5; outline-offset: 2px; }
        .wf-graph { height: clamp(440px, 66vh, 850px); width: 100%; overflow: hidden; background-color: #fbfcfe; background-image: radial-gradient(#dce3ed .8px, transparent .8px); background-size: 18px 18px; touch-action: none; cursor: grab; }
        .wf-graph:active { cursor: grabbing; }
        .wf-graph svg { width: 100%; height: 100%; display: block; }
        .wf-graph g.node { cursor: pointer; }
        .wf-graph g.node:focus { outline: none; }
        .wf-graph g.node:focus > polygon, .wf-graph g.node:focus > path { stroke: #2563eb; stroke-width: 3; }
        .wf-graph g.node, .wf-graph g.edge { transition: opacity .15s; }
        .wf-graph .wf-dim { opacity: .16; }
        .wf-graph .wf-selected > path, .wf-graph .wf-selected > polygon { stroke: #2563eb; stroke-width: 3; fill: #dbeafe; }
        .wf-graph .wf-connected path { stroke: #2563eb; stroke-width: 2; }
        .wf-graph .wf-connected polygon { fill: #2563eb; stroke: #2563eb; }
        .wf-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 13px 20px; border-top: 1px solid #e8edf3; font-size: 11px; color: var(--wf-muted); }
        .wf-legend { display: flex; gap: 14px; align-items: center; }
        .wf-key { display: inline-block; width: 10px; height: 10px; border: 1px solid #cbd5e1; border-radius: 3px; margin-right: 5px; vertical-align: middle; }
        .wf-key-start { background: #eff6ff; border-color: #2563eb; }
        .wf-key-end { background: #f1f5f9; border: 3px double #64748b; }
        .wf-sidebar { align-self: start; }
        .wf-sidebar-head { padding: 20px; border-bottom: 1px solid #e8edf3; }
        .wf-sidebar-head h3 { font-size: 15px; margin: 0 0 6px; }
        .wf-hint { color: var(--wf-muted); font-size: 12px; line-height: 1.6; margin: 0; }
        .wf-search { width: 100%; border: 1px solid #dce3ec; border-radius: 8px; padding: 9px 11px; margin-top: 14px; font: inherit; font-size: 12px; }
        .wf-places { max-height: 55vh; overflow-y: auto; }
        .wf-place-row { border-bottom: 1px solid #edf1f6; padding: 14px 18px; }
        .wf-place-row:last-child { border-bottom: 0; }
        .wf-place-row.wf-active { background: #eff6ff; box-shadow: inset 3px 0 #2563eb; }
        .wf-place { display: flex; gap: 8px; align-items: center; width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; font: inherit; font-size: 13px; font-weight: 600; }
        .wf-tag { margin-left: auto; flex-shrink: 0; font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: #64748b; background: #f1f5f9; border-radius: 4px; padding: 2px 5px; }
        .wf-tag-start { color: #1d4ed8; background: #dbeafe; }
        .wf-code { display: block; margin: 4px 0 0; font-size: 10px; color: #8996a8; overflow-wrap: anywhere; }
        .wf-description { margin: 8px 0 0; font-size: 11px; line-height: 1.6; color: var(--wf-muted); overflow-wrap: anywhere; }
        .wf-transition { margin-top: 10px; padding-top: 10px; border-top: 1px solid #dce6f4; font-size: 11px; }
        .wf-transition strong { color: #334d70; }
        .wf-transition small { display: block; margin-top: 3px; color: var(--wf-muted); }
        .wf-guard { margin-top: 8px; padding: 8px 10px; border-radius: 6px; background: #f1f5f9; }
        .wf-guard code { display: block; margin-top: 4px; font-size: 10px; color: #334d70; white-space: pre-wrap; overflow-wrap: anywhere; }
        .wf-status { padding: 22px; color: var(--wf-muted); }
        @media (max-width: 1000px) { .wf-layout { grid-template-columns: 1fr; } .wf-places { max-height: 350px; } .wf-graph { height: 60vh; min-height: 400px; } }
        @media (prefers-reduced-motion: reduce) { .wf-graph g.node, .wf-graph g.edge { transition: none; } }
    </style>
{% endblock %}
{% block body %}
    {% set controller = survos_stimulus('state-bundle', 'workflow') %}
    {% set digraphData = digraph is defined ? digraph : workflow_digraph(entity, flowCode) %}
    <div class="wf-explorer" {{ stimulus_controller(controller, {digraph: digraphData}) }}>
        <div class="wf-layout">
            <section class="wf-canvas" aria-label="Workflow diagram">
                <header class="wf-toolbar">
                    <div><div class="wf-eyebrow">Workflow map</div><h2>{{ definition.places|length }} states <span class="text-secondary">/ {{ definition.transitions|length }} transitions</span></h2></div>
                    <div class="wf-controls" aria-label="Diagram controls">
                        <button class="wf-button" type="button" {{ stimulus_action(controller, 'zoomOut') }} aria-label="Zoom out">−</button>
                        <button class="wf-button" type="button" {{ stimulus_action(controller, 'zoomIn') }} aria-label="Zoom in">+</button>
                        <button class="wf-button" type="button" {{ stimulus_action(controller, 'fit') }}>Fit</button>
                        <button class="wf-button" type="button" {{ stimulus_action(controller, 'clear') }}>Show all</button>
                    </div>
                </header>
                <div id="digraphData" class="wf-graph" {{ stimulus_target(controller, 'graph') }} aria-label="Interactive workflow map">
                    <p class="wf-status" role="status">Loading workflow diagram…</p>
                </div>
                <footer class="wf-footer">
                    <div class="wf-legend"><span><i class="wf-key wf-key-start"></i>Start</span><span><i class="wf-key"></i>State</span><span><i class="wf-key wf-key-end"></i>Terminal</span></div>
                    <span {{ stimulus_target(controller, 'status') }} role="status" aria-live="polite">Select a state to trace its connections · Drag to pan · Option/Alt + scroll or pinch to zoom</span>
                </footer>
            </section>
            <aside class="wf-sidebar" aria-label="Workflow states">
                <div class="wf-sidebar-head"><h3>Explore states</h3><p class="wf-hint">Select a state to see its paths and the guard expressions that allow each transition.</p>
                    <input class="wf-search" type="search" placeholder="Find a state…" aria-label="Find a state" {{ stimulus_target(controller, 'search') }} {{ stimulus_action(controller, 'search', 'input') }}>
                </div>
                <div class="wf-places">
                    {% for place in definition.places %}
                        {% set label = survos_workflow_metadata(flowCode, 'label', place) ?: place|replace({'_': ' '})|title %}
                        {% set description = survos_workflow_metadata(flowCode, 'description', place) %}
                        {% set transitions = definition.transitions|filter(t => place in t.froms) %}
                        <div class="wf-place-row" data-place="{{ place }}" {{ stimulus_target(controller, 'place') }}>
                            <button class="wf-place" type="button" data-place="{{ place }}" {{ stimulus_action(controller, 'select') }} aria-pressed="false">
                                {{ label }}
                                {% if place in definition.initialPlaces %}<span class="wf-tag wf-tag-start">Start</span>{% elseif transitions is empty %}<span class="wf-tag">Terminal</span>{% endif %}
                            </button>
                            <span class="wf-code">{{ place }}</span>
                            <div class="wf-details" hidden>
                                {% if description %}<p class="wf-description">{{ description }}</p>{% endif %}
                                {% for t in transitions %}
                                    <div class="wf-transition"><strong>{{ survos_workflow_metadata(flowCode, 'label', t) ?: t.name|replace({'_': ' '})|title }}</strong> → {{ t.tos|join(', ')|replace({'_': ' '}) }}
                                        {% set transitionDescription = survos_workflow_metadata(flowCode, 'description', t) %}
                                        {% if transitionDescription %}<small>{{ transitionDescription }}</small>{% endif %}
                                        {% set guard = survos_workflow_metadata(flowCode, 'guard', t) %}
                                        {% if guard %}<div class="wf-guard"><span class="wf-eyebrow">{{ survos_workflow_metadata(flowCode, 'guardLabel', t)|default('Guard') }}</span><code>{{ guard }}</code></div>{% endif %}
                                        {% if commandRouteExists|default(false) %}<a href="{{ path('survos_command', {commandName: 'state:iterate', transition: t.name, marking: place}) }}">View command</a>{% endif %}
                                    </div>
                                {% else %}<p class="wf-description">No outgoing transitions.</p>{% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                    <p class="wf-status" {{ stimulus_target(controller, 'empty') }} hidden>No matching states.</p>
                </div>
            </aside>
        </div>
    </div>
    {% if app.request.query.get('debug', false) %}<pre class="mt-3">{{ digraphData }}</pre>{% endif %}
{% endblock %}
